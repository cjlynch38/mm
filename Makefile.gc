# Native GameCube build of Majora's Mask (devkitPPC + libogc).
#
#   make            # first: the normal N64 build must exist (build/n64-us)
#   make -f Makefile.gc -j$(nproc)
#
# This file is independent of the N64 Makefile, which stays untouched so the
# matching build is unaffected. GameCube-specific source lives in port/gc/.
# See port/gc/README.md.

MAKEFLAGS += --no-builtin-rules
.DEFAULT_GOAL := all
SHELL = /usr/bin/env bash
.SHELLFLAGS = -o pipefail -c

VERSION        := n64-us
N64_BUILD_DIR  := build/$(VERSION)
BUILD_DIR      := build/gc-$(VERSION)
EXTRACTED_DIR  := extracted/$(VERSION)
N64_ELF        := $(N64_BUILD_DIR)/mm-$(VERSION).elf

DEVKITPRO ?= /opt/devkitpro
DEVKITPPC ?= $(DEVKITPRO)/devkitPPC
PREFIX    := $(DEVKITPPC)/bin/powerpc-eabi-
CC        := $(PREFIX)gcc
AS        := $(PREFIX)as
SIZE      := $(PREFIX)size
OBJCOPY   := $(PREFIX)objcopy
PYTHON    := .venv/bin/python3
SHIFTJIS_CONV := $(PYTHON) tools/buildtools/shiftjis_conv.py

ifeq ($(wildcard $(N64_ELF)),)
$(error $(N64_ELF) not found. Run the normal N64 build first ("make init" or "make"))
endif

#### Flags ####

# Game translation units: compiled against the decomp's own headers and libc,
# never against libogc headers (types and names such as Mtx, Vtx, gu* clash).
# GAME_DEFS adds test switches to the game code, like GFX_DEFS below (use a separate BUILD_DIR).
GAME_DEFS     ?=
GAME_CPPFLAGS := -nostdinc -Iinclude -Iinclude/libc -Isrc -I$(N64_BUILD_DIR) -I. -I$(EXTRACTED_DIR) \
                 -Iport/gc/include -include port/gc/include/gc_prelude.h \
                 -D_LANGUAGE_C -DF3DEX_GBI_2 -DF3DEX_GBI_PL -DGBI_DOWHILE -DMM_VERSION=N64_US \
                 -DNON_MATCHING -DAVOID_UB -DTARGET_GC -DGEKKO $(GAME_DEFS)

GAME_CFLAGS := -mcpu=750 -meabi -mhard-float -G0 -O2 -std=gnu17 \
               -funsigned-char -fno-strict-aliasing -fwrapv -ffp-contract=off \
               -fno-aggressive-loop-optimizations -fno-delete-null-pointer-checks \
               -fno-common -ffreestanding -fbuiltin -fno-builtin-sinf -fno-builtin-cosf \
               -fno-function-sections -fno-data-sections -fno-toplevel-reorder -fno-ipa-icf \
               -fno-asynchronous-unwind-tables -ftrivial-auto-var-init=zero

GAME_WARNINGS := -Wno-unknown-pragmas -Wno-multichar -Wno-builtin-declaration-mismatch

# Platform layer code compiled with the game's headers (port/gc/ultra, port/gc/game)
PORT_WARNINGS := -Wall -Wextra -Wno-unused-parameter -Wno-missing-field-initializers

# Platform code that talks to libogc (port/gc/ogc): libogc headers, never the game's.
MACHDEP    := -DGEKKO -mogc -mcpu=750 -meabi -mhard-float
OGC_CFLAGS := $(MACHDEP) -O2 -std=gnu17 -Wall -Wextra -Wno-unused-parameter -fno-strict-aliasing \
              -I$(DEVKITPRO)/libogc/include -Iport/gc/include

# The renderer (port/gc/gfx): libogc headers too; gfx_gx.c also uses the ogc-internal gc_ogc.h (video mode).
# GFX_DEFS adds renderer test switches, e.g. GFX_DEFS="-DGFX_LAZY_SYNC=0 -DGFX_DECAL_BIAS_SHIFT=14" (use a separate
# BUILD_DIR: objects are not rebuilt when it changes).
GFX_DEFS   ?=
GFX_CFLAGS := $(OGC_CFLAGS) -Iport/gc/gfx -Iport/gc/ogc $(GFX_DEFS)

#### Object list ####

# Every object the N64 spec links, minus what the GameCube replaces:
#  - overlay relocation tables, ROM header/IPL, RSP microcode, MIPS-gcc helpers
#  - assets / baserom segments (read from the user's ROM at runtime)
#  - libultra OS/IO/voice/debug (replaced by port/gc/ultra) and all MIPS .s files
#  - libc pieces provided by newlib, MIPS-only loaders, flash driver (shimmed)
SPEC_O_FILES := $(shell gcc -E -P -xc -fno-dollars-in-identifiers -DMM_VERSION=N64_US -I. spec/spec \
                  | sed -e 's|$$(BUILD_DIR)|$(N64_BUILD_DIR)|g' \
                  | sed -n -E 's/^[ \t]*include[ \t]*"([a-zA-Z0-9/_.-]+\.o)"/\1/p' \
                  | sed -e 's|^$(N64_BUILD_DIR)/||')

GC_EXCLUDE := %_reloc.o src/makerom/% rsp/% src/gcc_fix/% assets/% baserom/% \
              src/libultra/os/% src/libultra/io/% src/libultra/voice/% src/libultra/debug/% \
              src/libultra/mgu/% src/libultra/gu/sqrtf.o src/libultra/gu/libm_vals.o \
              src/libultra/libc/string.o src/libultra/libc/ldiv.o src/libultra/libc/ll.o \
              src/libultra/libc/llcvt.o src/libultra/libc/bzero.o src/libultra/libc/bcmp.o \
              src/libultra/libc/bcopy.o \
              src/boot/libc/% src/boot/libm/fmodf.o src/boot/libc64/fp.o \
              src/boot/libu64/loadfragment.o src/boot/libu64/loadfragment2.o \
              src/code/kanread.o src/code/osFlash.o \
              src/audio/code_8019AE40.o src/audio/code_8019AEC0.o \
              src/audio/lib/aisetnextbuf.o src/audio/lib/stack.o

GAME_O_REL   := $(filter-out $(GC_EXCLUDE),$(SPEC_O_FILES))
GAME_O_FILES := $(addprefix $(BUILD_DIR)/,$(GAME_O_REL)) \
                $(BUILD_DIR)/assets/audio/sequence_font_table.o

SHIFTJIS_C_FILES := src/audio/voice_external.c src/code/z_message.c src/code/z_message_nes.c
SHIFTJIS_O_FILES := $(foreach f,$(SHIFTJIS_C_FILES:.c=.o),$(BUILD_DIR)/$f)

# Platform layer (port/gc). ultra/, game/ and audio/ use the game's headers; ogc/ uses libogc's.
PORT_GAME_C  := $(wildcard port/gc/ultra/*.c port/gc/game/*.c port/gc/audio/*.c)
PORT_OGC_C   := $(wildcard port/gc/ogc/*.c port/gc/gfx/*.c)
PORT_O_FILES := $(foreach f,$(PORT_GAME_C:.c=.o) $(PORT_OGC_C:.c=.o),$(BUILD_DIR)/$f)

DEP_FILES := $(GAME_O_FILES:.o=.d) $(PORT_O_FILES:.o=.d)

#### Build options ####

# make -f Makefile.gc GC_AUTOSTART=1: press Start automatically on the title screen (unattended test runs).
# make -f Makefile.gc GC_RENDERER=0: no GX renderer, the M2 text console stays the display (graphics tasks skipped).
# make -f Makefile.gc GC_AUDIO=0: no sound; the audio driver runs without submitting audio tasks, as in M2.
# Options are written to gc_options.h, which only changes (and triggers rebuilds) when an option does.
GC_AUTOSTART ?= 0
GC_RENDERER  ?= 1
GC_AUDIO     ?= 1
GC_OPTIONS_H := $(BUILD_DIR)/generated/gc_options.h

$(GC_OPTIONS_H): FORCE
	@mkdir -p $(@D)
	@printf '#define GC_AUTOSTART %d\n#define GC_RENDERER %d\n#define GC_AUDIO %d\n' \
	    $(GC_AUTOSTART) $(GC_RENDERER) $(GC_AUDIO) > $@.tmp; \
	    cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

GC_OPTIONS_GAME_O := $(BUILD_DIR)/port/gc/ultra/cont.o $(BUILD_DIR)/port/gc/game/trace.o \
                     $(BUILD_DIR)/port/gc/ultra/ai.o $(BUILD_DIR)/src/code/audio_thread_manager.o
GC_OPTIONS_OGC_O  := $(BUILD_DIR)/port/gc/gfx/gfx_task.o
GC_OPTIONS_PLATFORM_O := $(BUILD_DIR)/port/gc/ogc/platform.o
$(GC_OPTIONS_GAME_O) $(GC_OPTIONS_OGC_O) $(GC_OPTIONS_PLATFORM_O): $(GC_OPTIONS_H)
$(GC_OPTIONS_GAME_O): GAME_CPPFLAGS += -I$(BUILD_DIR)/generated
$(GC_OPTIONS_OGC_O): GFX_CFLAGS += -I$(BUILD_DIR)/generated
$(GC_OPTIONS_PLATFORM_O): OGC_CFLAGS += -DGC_AUTOSTART=$(GC_AUTOSTART)

# make -f Makefile.gc GC_ROM_FLAGS='-DGC_ROM_TRACE=1 ...': options of the ROM reader (the GC_ROM_* macros at
# the top of port/gc/ogc/bridge_rom.c and platform.c). Its objects rebuild when the flags change.
GC_ROM_FLAGS ?=
GC_ROM_FLAGS_STAMP := $(BUILD_DIR)/generated/gc_rom_flags.txt
GC_ROM_O := $(BUILD_DIR)/port/gc/ogc/bridge_rom.o $(BUILD_DIR)/port/gc/ogc/platform.o

# make -f Makefile.gc GC_ROM_CHECK=1: after the boot, read the whole ROM back the way the game's DMA does and compare
# every 64 KB with checksums of baseroms/<version>/baserom.z64 (generated into the build directory; never commit it).
GC_ROM_CHECK ?= 0
ifeq ($(GC_ROM_CHECK),1)
GC_ROM_FLAGS += -DGC_ROM_CHECK=1
GC_ROM_CRC_C := $(BUILD_DIR)/generated/gc_rom_crc.c
GC_ROM_CRC_O := $(GC_ROM_CRC_C:.c=.o)
$(GC_ROM_CRC_C): baseroms/$(VERSION)/baserom.z64 port/gc/tools/gen_rom_crc.py
	@mkdir -p $(@D)
	$(PYTHON) port/gc/tools/gen_rom_crc.py --rom $< -o $@
$(GC_ROM_CRC_O): $(GC_ROM_CRC_C)
	$(CC) -c $(OGC_CFLAGS) -o $@ $<
endif

$(GC_ROM_FLAGS_STAMP): FORCE
	@mkdir -p $(@D)
	@printf '%s\n' '$(GC_ROM_FLAGS)' > $@.tmp; \
	    cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

$(GC_ROM_O): $(GC_ROM_FLAGS_STAMP)
$(GC_ROM_O): OGC_CFLAGS += $(GC_ROM_FLAGS)

#### Per-file settings (mirror the N64 Makefile) ####

$(BUILD_DIR)/src/boot/build.o: GAME_CPPFLAGS += -DBUILD_CREATOR="\"zelda@srd44\"" -DBUILD_DATE="\"00-07-31\"" -DBUILD_TIME="\"17:04:16\""
$(BUILD_DIR)/src/audio/lib/seqplayer.o: GAME_CPPFLAGS += -DMML_VERSION=MML_VERSION_MM
$(BUILD_DIR)/src/audio/tables/sequence_table.o: GAME_CPPFLAGS += -Iinclude/tables

# Drop the weak sinf/cosf aliases (#pragma weak) so newlib/libogc never bind to the N64 versions
POSTPROCESS_OBJ := @:
$(BUILD_DIR)/src/libultra/gu/sinf.o: POSTPROCESS_OBJ = $(OBJCOPY) --strip-symbol=sinf $@
$(BUILD_DIR)/src/libultra/gu/cosf.o: POSTPROCESS_OBJ = $(OBJCOPY) --strip-symbol=cosf $@

#### Targets ####

.PHONY: all objs port sizes clean
all: objs port dol apploader

port: $(PORT_O_FILES)
	@echo "Compiled $(words $(PORT_O_FILES)) platform objects"

objs: $(GAME_O_FILES)
	@echo "Compiled $(words $(GAME_O_FILES)) game objects into $(BUILD_DIR)"

# Code size per area, for the memory budget
sizes: $(GAME_O_FILES)
	@for area in src/boot src/code src/audio src/libultra src/buffers src/dmadata src/overlays/actors \
	              src/overlays/effects src/overlays/gamestates src/overlays/kaleido_scope src/overlays/fbdemos; do \
	    files=$$(echo $(GAME_O_FILES) | tr ' ' '\n' | grep "^$(BUILD_DIR)/$$area/"); \
	    [ -n "$$files" ] || continue; \
	    $(SIZE) -t $$files | tail -1 | awk -v a=$$area '{printf "%-28s text %9d  data %8d  bss %8d\n", a, $$1, $$2, $$3}'; \
	done; \
	$(SIZE) -t $(GAME_O_FILES) | tail -1 | awk '{printf "%-28s text %9d  data %8d  bss %8d\n", "TOTAL", $$1, $$2, $$3}'

clean:
	rm -rf $(BUILD_DIR)

#### Rules ####

$(SHIFTJIS_O_FILES): $(BUILD_DIR)/src/%.o: src/%.c
	@mkdir -p $(@D)
	$(SHIFTJIS_CONV) -o $(@:.o=.enc.c) $<
	$(CC) -c $(GAME_CPPFLAGS) $(GAME_CFLAGS) $(GAME_WARNINGS) -fexec-charset=euc-jp -MMD -MP -MT $@ -o $@ $(@:.o=.enc.c)

$(BUILD_DIR)/src/%.o: src/%.c
	@mkdir -p $(@D)
	$(CC) -c $(GAME_CPPFLAGS) $(GAME_CFLAGS) $(GAME_WARNINGS) -fexec-charset=euc-jp -MMD -MP -o $@ $<
	$(POSTPROCESS_OBJ)

$(BUILD_DIR)/port/gc/ogc/%.o: port/gc/ogc/%.c
	@mkdir -p $(@D)
	$(CC) -c $(OGC_CFLAGS) -MMD -MP -o $@ $<

# Audio command list interpreter (port/gc/audio): the game's headers and flags, like port/gc/game
$(BUILD_DIR)/port/gc/audio/%.o: port/gc/audio/%.c
	@mkdir -p $(@D)
	$(CC) -c $(GAME_CPPFLAGS) $(GAME_CFLAGS) $(GAME_WARNINGS) $(PORT_WARNINGS) -MMD -MP -o $@ $<

# Renderer (libogc headers, own GBI constants in gfx_gbi.h)
$(BUILD_DIR)/port/gc/gfx/%.o: port/gc/gfx/%.c
	@mkdir -p $(@D)
	$(CC) -c $(GFX_CFLAGS) -MMD -MP -o $@ $<

$(BUILD_DIR)/port/gc/%.o: port/gc/%.c
	@mkdir -p $(@D)
	$(CC) -c $(GAME_CPPFLAGS) $(GAME_CFLAGS) $(GAME_WARNINGS) $(PORT_WARNINGS) -MMD -MP -o $@ $<

$(BUILD_DIR)/assets/audio/sequence_font_table.o: $(N64_BUILD_DIR)/assets/audio/sequence_font_table.s
	@mkdir -p $(@D)
	sed -e 's/.half /.2byte /' $< > $(@:.o=.ppc.s)
	$(AS) -o $@ $(@:.o=.ppc.s)

-include $(DEP_FILES)

#### Link: ELF and DOL ####

# port/gc/tools/gen_gc_link.py generates the link inputs from spec/spec, the matching N64 ELF and GAME_O_FILES:
#   mm_gc.ld                devkitPPC's ogc.ld layout, plus every overlay as one contiguous block (_<seg>Segment*)
#   abs_syms.ld             PROVIDE() of the N64 asset/ROM symbols (segmented addresses, VROM offsets)
#   generated/ovl_ranges.c  overlay link ranges for the static overlay runtime
# check_dmadata.py then checks the VROM symbols against the dmadata table of the user's ROM.
NM          := $(PREFIX)nm
MIPS_NM     := mips-linux-gnu-nm
ELF2DOL     := $(DEVKITPRO)/tools/bin/elf2dol
BASEROM_DIR := baseroms/$(VERSION)

GC_OBJ_LIST    := $(BUILD_DIR)/game_o_files.txt
GC_LD_SCRIPT   := $(BUILD_DIR)/mm_gc.ld
GC_ABS_SYMS_LD := $(BUILD_DIR)/abs_syms.ld
GC_EXTRA_LD    := $(BUILD_DIR)/linker_scripts/undefined_syms.ld
OVL_RANGES_C   := $(BUILD_DIR)/generated/ovl_ranges.c
OVL_RANGES_O   := $(BUILD_DIR)/generated/ovl_ranges.o
DMADATA_OK     := $(BUILD_DIR)/dmadata_check.ok
LINK_GEN       := $(GC_LD_SCRIPT) $(GC_ABS_SYMS_LD) $(GC_EXTRA_LD) $(OVL_RANGES_C) $(DMADATA_OK)

GC_ELF       := $(BUILD_DIR)/mm-gc.elf
GC_MAP       := $(BUILD_DIR)/mm-gc.map
GC_DOL       := $(BUILD_DIR)/mm-gc.dol
GC_PROBE_ELF := $(BUILD_DIR)/probe/mm-gc-probe.elf

LINK_O_FILES := $(GAME_O_FILES) $(PORT_O_FILES) $(OVL_RANGES_O) $(GC_ROM_CRC_O)
GC_LIB_DIR   := $(DEVKITPRO)/libogc/lib/cube

# -mogc adds devkitPPC's crt objects and system libraries. Given -T, it drops its default ogc.ld (mm_gc.ld replaces
# it; several -T scripts accumulate). Its link spec also passes --gc-sections, which --no-gc-sections overrides.
GC_LDFLAGS := -mogc -mcpu=750 -meabi -mhard-float \
              -T $(GC_LD_SCRIPT) -T $(GC_ABS_SYMS_LD) -T $(GC_EXTRA_LD) \
              -Wl,--no-gc-sections -L$(GC_LIB_DIR)
# libiso9660: the Dolphin dev disc (Dolphin has no GameCube SD card), see port/gc/ogc/storage.c
GC_LIBS    := -liso9660 -lfat -logc -lm

# Libraries whose symbol names abs_syms.ld must not PROVIDE
GC_TOOLCHAIN_LIBS := $(GC_LIB_DIR)/libiso9660.a $(GC_LIB_DIR)/libfat.a $(GC_LIB_DIR)/libogc.a \
                     $(addprefix $(DEVKITPPC)/powerpc-eabi/lib/,libm.a libc.a libsysbase.a) \
                     $(wildcard $(DEVKITPPC)/lib/gcc/powerpc-eabi/*/libgcc.a)

GEN_GC_LINK      := $(PYTHON) port/gc/tools/gen_gc_link.py
GEN_GC_LINK_ARGS := --objs $(GC_OBJ_LIST) --gc-build-dir $(BUILD_DIR) --nm $(NM)

.PHONY: link-gen elf dol link-probe link-undefined FORCE
FORCE:

link-gen: $(LINK_GEN)
elf: $(GC_ELF)
dol: $(GC_DOL)

# make -f Makefile.gc -s print-GAME_O_FILES
print-%: ; @echo $($*)

# The object list as a file that only changes when the list does, so the generators rerun only when needed
$(GC_OBJ_LIST): FORCE
	@mkdir -p $(@D)
	@printf '%s\n' $(GAME_O_FILES) > $@.tmp; cmp -s $@.tmp $@ && rm -f $@.tmp || mv -f $@.tmp $@

# D_0x000000 segment base symbols (absolute). As in the N64 Makefile, run through cpp: the file has C comments.
$(GC_EXTRA_LD): linker_scripts/final/undefined_syms.ld
	@mkdir -p $(@D)
	gcc -E -P -xc -fno-dollars-in-identifiers -DMM_VERSION=N64_US $< > $@

$(GC_LD_SCRIPT) $(GC_ABS_SYMS_LD) $(OVL_RANGES_C) &: spec/spec include/versions.h $(N64_ELF) $(GC_OBJ_LIST) \
                                                      $(GC_EXTRA_LD) port/gc/tools/gen_gc_link.py
	$(GEN_GC_LINK) generate $(GEN_GC_LINK_ARGS) --out-dir $(BUILD_DIR) --n64-elf $(N64_ELF) --mips-nm $(MIPS_NM) \
	    --extra-ld $(GC_EXTRA_LD) $(addprefix --lib ,$(GC_TOOLCHAIN_LIBS))

$(DMADATA_OK): $(GC_ABS_SYMS_LD) $(BASEROM_DIR)/baserom.z64 $(BASEROM_DIR)/segments.csv port/gc/tools/check_dmadata.py
	$(PYTHON) port/gc/tools/check_dmadata.py --rom $(BASEROM_DIR)/baserom.z64 --segments $(BASEROM_DIR)/segments.csv \
	    --abs-syms $(GC_ABS_SYMS_LD)
	@touch $@

$(OVL_RANGES_O): $(OVL_RANGES_C)
	$(CC) -c $(GAME_CPPFLAGS) $(GAME_CFLAGS) $(GAME_WARNINGS) $(PORT_WARNINGS) -MMD -MP -o $@ $<

-include $(OVL_RANGES_O:.o=.d)

$(GC_ELF): $(LINK_O_FILES) $(LINK_GEN)
	$(CC) $(GC_LDFLAGS) -Wl,-Map,$(GC_MAP) -o $@ $(LINK_O_FILES) $(GC_LIBS)
	$(GEN_GC_LINK) verify $(GEN_GC_LINK_ARGS) --elf $@ --map $(GC_MAP) || { rm -f $@; exit 1; }

# elf2dol leaves the last section unpadded, which Dolphin rejects; dolpad.py pads it
$(GC_DOL): $(GC_ELF)
	$(ELF2DOL) $< $@
	$(PYTHON) port/gc/tools/dolpad.py $@

#### Bootable disc image ####

# make -f Makefile.gc iso: build/gc-n64-us/mm-gc.iso, a GameCube disc image (game ID GMME00) with the
# port's own apploader (port/gc/apploader, CC0), the DOL and YOUR ROM as /mmgcport/baserom.z64. It is
# built locally from baseroms/n64-us/baserom.z64 and must never be committed or shared (build/ is
# gitignored). See port/gc/README.md for booting it in Dolphin and with Swiss.
GC_APPLOADER_DIR := $(BUILD_DIR)/apploader
GC_APPLOADER_ELF := $(GC_APPLOADER_DIR)/apploader.elf
GC_ISO           := $(BUILD_DIR)/mm-gc.iso
APPLOADER_CFLAGS := -mcpu=750 -meabi -mhard-float -G0 -msdata=none -O2 -std=gnu17 -ffreestanding -fno-builtin \
                    -fno-tree-loop-distribute-patterns -fno-asynchronous-unwind-tables -Wall -Wextra

.PHONY: apploader iso
apploader: $(GC_APPLOADER_ELF)
iso: $(GC_ISO)

$(GC_APPLOADER_DIR)/apploader.o: port/gc/apploader/apploader.c
	@mkdir -p $(@D)
	$(CC) -c $(APPLOADER_CFLAGS) -MMD -MP -o $@ $<

-include $(GC_APPLOADER_DIR)/apploader.d

$(GC_APPLOADER_ELF): $(GC_APPLOADER_DIR)/apploader.o port/gc/apploader/apploader.ld
	$(CC) -mcpu=750 -meabi -mhard-float -nostdlib -nostartfiles -T port/gc/apploader/apploader.ld \
	    -Wl,-Map,$(@:.elf=.map) -o $@ $<

$(GC_ISO): $(GC_DOL) $(GC_APPLOADER_ELF) $(BASEROM_DIR)/baserom.z64 port/gc/tools/mkiso.py port/gc/tools/mkdevdisc.py
	$(PYTHON) port/gc/tools/mkiso.py --dol $(GC_DOL) --apploader $(GC_APPLOADER_ELF) \
	    --rom $(BASEROM_DIR)/baserom.z64 -o $@

# Link with unresolved symbols allowed, to inspect the layout before the platform layer is complete
link-probe: $(LINK_O_FILES) $(LINK_GEN)
	@mkdir -p $(dir $(GC_PROBE_ELF))
	$(CC) $(GC_LDFLAGS) -Wl,--unresolved-symbols=ignore-all -Wl,-Map,$(GC_PROBE_ELF:.elf=.map) \
	    -o $(GC_PROBE_ELF) $(LINK_O_FILES) $(GC_LIBS)
	$(GEN_GC_LINK) verify $(GEN_GC_LINK_ARGS) --elf $(GC_PROBE_ELF) --map $(GC_PROBE_ELF:.elf=.map)

# Symbols the link still lacks (what the platform layer has yet to provide), one per line
link-undefined: $(LINK_O_FILES) $(LINK_GEN)
	@mkdir -p $(dir $(GC_PROBE_ELF))
	@{ $(CC) $(GC_LDFLAGS) -o $(GC_PROBE_ELF:.elf=-undef.elf) $(LINK_O_FILES) $(GC_LIBS) 2>&1 || true; } \
	    | sed -n -E "s/.*undefined reference to [\`']([^']+)'.*/\1/p" | sort -u
